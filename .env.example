# Compose project name
# - default: gameformer
COMPOSE_PROJECT_NAME=gameformer

# Image identifier
# - default: gameformer:cu118-py310-torch2.3.1
IMAGE_REPO=gameformer
IMAGE_TAG=cu118-py310-torch2.3.1

# Container 사용자 매핑 (host UID/GID와 일치시켜야 mount된 file이 host에서 root 소유로 보이지 않음)
# - default: 1000/1000
USER_UID=1000
USER_GID=1000

# Container에 노출할 GPU
# - allowed: integer | "all" | comma-separated device id (예: "0,1")
# - default: all (3060 host: 1 GPU / H200 host: 모든 GPU)
DOCKER_GPUS=all

# /dev/shm 크기 (DataLoader workers, NCCL 등)
# - default: 8gb
SHM_SIZE=8gb

# Compute capability 목록 (custom CUDA extension build 시 참조)
# - 8.6 = RTX 3060 (Ampere), 9.0+PTX = H200 (Hopper, forward-compat 포함)
TORCH_CUDA_ARCH_LIST=8.6;9.0+PTX
CMAKE_CUDA_ARCHITECTURES=86;90

# Dataset root (host 경로). symlink 권장: ln -s /mnt/e/datasets/womd ./data
# - 컨테이너 내부 mount target: /workspace/GameFormer/data
# - default: ./data (repo 내부 또는 symlink)
DATASET_HOME=./data

# Container 기본 실행 command
# - default: sleep infinity ("docker compose up -d" → "docker compose exec gameformer bash" 패턴)
COMPOSE_COMMAND=sleep infinity
